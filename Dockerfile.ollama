FROM ollama/ollama:latest

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && printf '#!/bin/sh\nollama serve &\necho "Waiting for Ollama..."\nuntil curl -sf http://localhost:11434/api/version > /dev/null 2>&1; do sleep 2; done\necho "Ollama ready — pulling ${OLLAMA_MODEL:-llama3.2:3b}"\nollama pull ${OLLAMA_MODEL:-llama3.2:3b}\necho "Model ready"\nwait\n' > /entrypoint.sh \
    && chmod +x /entrypoint.sh

EXPOSE 11434

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
    CMD curl -sf http://localhost:11434/api/version || exit 1

ENTRYPOINT ["/bin/sh", "/entrypoint.sh"]
