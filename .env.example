# ─── Copy this file to .env and fill in your values ──────────────────────────

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Options: "ollama" | "vllm" | "openai"
LLM_PROVIDER=ollama

# Model name (Ollama tag, HF model id, or OpenAI model id)
LLM_MODEL=llama3

# Ollama server URL (default: local)
OLLAMA_BASE_URL=http://localhost:11434

# vLLM server URL (only needed when LLM_PROVIDER=vllm)
VLLM_BASE_URL=http://localhost:8000

# OpenAI API key (only needed when LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# ─── Embedding Model ──────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=cpu              # cpu | cuda | mps

# ─── Vector Store ─────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=knowledge_base

# Remote Chroma server (leave blank for local)
# CHROMA_HOST=localhost
# CHROMA_PORT=8001

# ─── Tools ────────────────────────────────────────────────────────────────────
# SerpAPI key for web search (leave blank to use DuckDuckGo fallback)
# SERPAPI_KEY=your-serpapi-key

PYTHON_EXEC_TIMEOUT=30
SQL_DATABASE_URL=sqlite:///./data/agent_data.db

# ─── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
DEBUG=false

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_API_URL=http://localhost:8000

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Agent Behaviour ──────────────────────────────────────────────────────────
MAX_AGENT_ITERATIONS=5
EVALUATION_RETRY_LIMIT=3
PLAN_MAX_STEPS=10

# ─── LangSmith Tracing (optional) ─────────────────────────────────────────────
# Set LANGCHAIN_TRACING_V2=true and provide your API key to enable tracing
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=AutonoML

# ─── Session Store (optional) ─────────────────────────────────────────────────
# Leave blank to use in-memory store (default). Set to enable Redis persistence.
# REDIS_URL=redis://localhost:6379/0
# SESSION_TTL_SECONDS=3600
